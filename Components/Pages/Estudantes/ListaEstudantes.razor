@code {

    private List<Estudante> estudantes = new();
    private string filtro = string.Empty;
    private bool loading = true;

    [Inject] private IRepository<Estudante> repository { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;



    protected override async Task OnInitializedAsync()
    {
        loading = true;
        var datos = await repository.GetAllAsync();
        estudantes = datos.ToList();
        loading = false;
    }



    private bool FilterFunc1(Estudante estudante)
    {
        return string.IsNullOrEmpty(filtro) || estudante.Nome.Contains(filtro, StringComparison.OrdinalIgnoreCase);
    }



    private async Task AdicionarEstudante()
    {
        try
        {
            var parameters = new DialogParameters();
            var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
            };

            var dialog = await DialogService.ShowAsync<CriarEstudante>("", parameters, options);
            var result = await dialog.Result;

            if (!result!.Canceled)
            {
                await OnInitializedAsync();
                NavigationManager.NavigateTo("/estudantes");
            }
        }

        catch (Exception ex)
        {
            Snackbar.Add("Ocorreu um error: " + ex.Message, Severity.Error);
        }
    }



    private async Task EditarEstudante(int id)
    {
        try
        {
            var parameters = new DialogParameters { ["EstudanteId"] = id };
            var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
            };

            var dialog = await DialogService.ShowAsync<EditarEstudante>("", parameters, options);
            var result = await dialog.Result;


            if (!result!.Canceled)
            {
                await OnInitializedAsync();
                Snackbar.Add("Estudante atualizado com sucesso!", Severity.Success);
                NavigationManager.NavigateTo("/estudantes");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Ocorreu um error: " + ex.Message, Severity.Error);
        }
    }




    private async Task DeletarEstudante(int id)
    {
        try
        {
            var parameters = new DialogParameters { ["EstudanteId"] = id };
            var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
            };

            var dialog = await DialogService.ShowAsync<DeletarEstudante>("", parameters, options);
            var result = await dialog.Result;

            if (!result!.Canceled)
            {
                await OnInitializedAsync();
                Snackbar.Add("Estudante deletado com sucesso!", Severity.Success);
                NavigationManager.NavigateTo("/estudantes");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Ocorreu un error: " + ex.Message, Severity.Error);
        }
    }
}