@using SistemaBiblioteca.Models

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="@estudante" Class="pa-4">
            <MudText Typo="Typo.h6">Criar Estudante</MudText>
            <MudTextField @bind-Value="estudante.Nome" Label="Nome" Required="true" />
            <MudTextField @bind-Value="estudante.Codigo" Label="Codigo" Required="true" />
            <MudButton OnClick="@Cadastar" Color="Color.Primary">Cadastrar</MudButton>
        </MudForm>
    </DialogContent>
</MudDialog>



@code {
    [Parameter] public int EstudanteId { get; set; }
    private Estudante estudante = new Estudante();

    [Inject] private IRepository<Estudante> Repository { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm form = null!;



    protected override async Task OnInitializedAsync()
    {
        try
        {
            estudante = await Repository.GetByIdAsync(EstudanteId);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Ocorreu um erro ao carregar um estudante: " + ex.Message, Severity.Error);
            MudDialog.Cancel();
        }
    }

    private async Task Cadastar()
    {
        await form.Validate();
        if (form.IsValid)
        {
            try
            {
                await Repository.UpdateAsync(estudante);
                MudDialog.Close(DialogResult.Ok(estudante));
            }
            catch (Exception ex)
            {
                Snackbar.Add("Ocorreu um error ao cadastrar um estudante: " + ex.Message, Severity.Error);
            }
        }
    }
}
