<MudDialog>
    <DialogContent>

        <MudText Typo="Typo.h4"
                 Class="mb-2 text-center"
                 Color="Color.Primary"
                 Style="font-weight:600;">
            Editar Estudante
        </MudText>

        <MudDivider Class="mb-4" />

        <MudForm @ref="form" Model="@estudante" Class="pa-6 rounded-lg">

            <MudTextField @bind-Value="estudante.Nome"
                          Label="Nome"
                          Required="true"
                          Variant="Variant.Filled"
                          Class="mb-4" />

            <MudTextField @bind-Value="estudante.Codigo"
                          Label="Código"
                          Required="true"
                          Variant="Variant.Filled"
                          Class="mb-6" />

            <MudButton OnClick="@Cadastar"
                       Color="Color.Secondary"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Style="height:48px; text-transform: none; font-weight: 600;">


                <MudText Typo="Typo.body1">
                    Cadastrar
                </MudText>


            </MudButton>

        </MudForm>
    </DialogContent>
</MudDialog>




@code {
    [Parameter] public int EstudanteId { get; set; }
    private Estudante estudante = new Estudante();

    [Inject] private IRepository<Estudante> Repository { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm form = null!;



    protected override async Task OnInitializedAsync()
    {
        try
        {
            estudante = await Repository.GetByIdAsync(EstudanteId);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Ocorreu um erro ao carregar um estudante: " + ex.Message, Severity.Error);
            MudDialog.Cancel();
        }
    }

    private async Task Cadastar()
    {
        await form.Validate();
        if (form.IsValid)
        {
            try
            {
                await Repository.UpdateAsync(estudante);
                MudDialog.Close(DialogResult.Ok(estudante));
            }
            catch (Exception ex)
            {
                Snackbar.Add("Ocorreu um error ao cadastrar um estudante: " + ex.Message, Severity.Error);
            }
        }
    }
}
