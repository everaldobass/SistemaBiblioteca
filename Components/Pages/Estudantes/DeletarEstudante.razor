
<MudDialog Style="width:500px; height:250px;">
    <DialogContent>
        <MudText Typo="Typo.h6" GutterBottom="true">Você está certo?</MudText>

        <MudText Typo="Typo.body1">
            Deseja continuar e excluir este cadastro?
        </MudText>

    </DialogContent>
    <DialogActions>

            <MudButton OnClick="Cancelar"
                   Class="mb-2"
                   Color="Color.Primary"
                       Variant="Variant.Filled"
                       Style="height:45px; width:100%; font-weight:500; border-radius:5px;">
            <MudText Typo="Typo.body1">
                Cancelar
            </MudText>
            </MudButton>

            <MudButton OnClick="Eliminar"
                   Class="mb-2"
                   Color="Color.Error"
                       Variant="Variant.Filled"
                       Style="height:45px; width:100%; font-weight:500; border-radius:5px;">


            <MudText  Typo="Typo.body1">
               Excluir
            </MudText>


            </MudButton>
  
    </DialogActions>
</MudDialog>






@code {
    [Parameter] public int EstudanteId { get; set; }

    private Estudante estudante = new Estudante();

    [Inject] private IRepository<Estudante> repository { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;



    protected override async Task OnInitializedAsync()
    {
        estudante = await repository.GetByIdAsync(EstudanteId);
    }

    private async Task Eliminar()
    {
        try
        {
            await repository.DeleteAsync(estudante.Id);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error ao deletar um estudante: {ex.Message}", Severity.Error);
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/estudantes");
    }
}