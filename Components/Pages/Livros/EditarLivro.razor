<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="@livro" Class="pa-4">
            <MudText Typo="Typo.h6">Editar Livro</MudText>
            <MudTextField @bind-Value="livro.Titulo" Label="Título" Required="true" />
            <MudTextField @bind-Value="livro.Codigo" Label="Código" Required="true" />
            <MudTextField @bind-Value="livro.Autor" Label="Autor" Required="true" />
            <MudDatePicker @bind-Date="_date" Label="Data Publicação" />
            <MudNumericField @bind-Value="livro.Quantidade" Label="Quantidade" Required="true" Min="1" />
            <MudSelect T="int" @bind-Value="livro.CategoriaId" Label="Categoría" Required="true">
                @if (categorias != null)
                {
                    @foreach (var categoria in categorias)
                    {
                        <MudSelectItem Value="@categoria.Id">@categoria.Nome</MudSelectItem>
                    }
                }
            </MudSelect>
            <MudButton OnClick="@Guardar" Color="Color.Primary">Guardar</MudButton>
        </MudForm>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public int LivroId { get; set; }
    private List<Categoria> categorias = [];
    private Livro livro = new Livro();
    private DateTime? _date = DateTime.Today;

    [Inject] private IRepository<Livro> Repository { get; set; } = null!;
    [Inject] private IRepository<Categoria> repositoryCategoria { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm form = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categorias = (await repositoryCategoria.GetAllAsync()).ToList();
            livro = await Repository.GetByIdAsync(LivroId);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Ocorreu um erro ao editar o livro: " + ex.Message, Severity.Error);
            MudDialog.Cancel();
        }
    }



    private async Task Guardar()
    {
        await form.Validate();
        if (form.IsValid)
        {
            try
            {
                livro.DataPublicacao = _date;
                await Repository.UpdateAsync(livro);
                MudDialog.Close(DialogResult.Ok(livro));
            }
            catch (Exception ex)
            {
                Snackbar.Add("Ocorreu um erro ao editar o livro: " + ex.Message, Severity.Error);
            }
        }
    }
}