<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="@livro" Class="pa-4">
            <MudText Typo="Typo.h6">Criar Livro</MudText>
            <MudTextField @bind-Value="livro.Titulo" Label="Título" Required="true" />
            <MudTextField @bind-Value="livro.Codigo" Label="Código" Required="true" />
            <MudTextField @bind-Value="livro.Autor" Label="Autor" Required="true" />
            <MudDatePicker @bind-Date="_date" Label="Data Publicacao" />
            <MudNumericField @bind-Value="livro.Quantidade" Label="Quantidade" Required="true" Min="1" />
            <MudSelect T="int" @bind-Value="livro.CategoriaId" Label="Categoría" Required="true">
                @if (categorias != null)
                {
                    @foreach (var categoria in categorias)
                    {
                        <MudSelectItem Value="@categoria.Id">@categoria.Nome</MudSelectItem>
                    }
                }
            </MudSelect>
            <MudButton OnClick="@Cadastrar"Color ="Color.Primary">Cadastrar</MudButton>
        </MudForm>
    </DialogContent>
</MudDialog>
@code {
    private Livro livro = new Livro();
    private List<Categoria> categorias = [];
    private MudForm form = null!;
    private DateTime? _date = DateTime.Today;

    [Inject] private IRepository<Livro> repository { get; set; } = null!;
    [Inject] private IRepository<Categoria> repositoryCategoria { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        categorias = (await repositoryCategoria.GetAllAsync()).ToList();
    }

    private async Task Cadastrar()
    {
        await form.Validate();
        if (form.IsValid)
        {
            try
            {
                livro.DataPublicacao = _date;
                await repository.AddAsync(livro);
                Snackbar.Add("Livro criado com sucesso.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error ao criar um livro: {ex.Message}", Severity.Error);
            }
        }
    }
}